{{!
    Template: format_iccaformat/local/content/section_cards
    Course home — grid of top-level section cards.
}}
{{! Base card shadow — always applied regardless of hover style }}
<style>.format-iccaformat-card-wrap{box-shadow:0 1px 4px rgba(0,0,0,0.07);}</style>
{{#hover_lift}}
<style>.format-iccaformat-card-wrap{box-shadow:0 1px 4px rgba(0,0,0,0.07);transition:transform 0.18s ease,box-shadow 0.18s ease;}.format-iccaformat-card-wrap:hover{transform:translateY(-4px);box-shadow:0 8px 20px rgba(0,0,0,0.13);}.format-iccaformat-card-wrap:active{transform:translateY(0);box-shadow:0 2px 6px rgba(0,0,0,0.1);}</style>
{{/hover_lift}}
{{#hover_imgzoom}}
<style>.format-iccaformat-card-wrap .format-iccaformat-card-image img{transition:transform 0.3s ease;}.format-iccaformat-card:hover .format-iccaformat-card-image img{transform:scale(calc({{hoverzoom}} / 100));}.format-iccaformat-card-wrap{box-shadow:0 1px 4px rgba(0,0,0,0.07);transition:transform 0.1s ease;}.format-iccaformat-card-wrap:hover{transform:scale(1.01);}.format-iccaformat-card-wrap:active{transform:scale(1.00);}</style>
{{/hover_imgzoom}}
{{#hover_shadow}}
<style>.format-iccaformat-card-wrap{box-shadow:0 1px 4px rgba(0,0,0,0.07);transition:box-shadow 0.2s ease;}.format-iccaformat-card-wrap:hover{box-shadow:0 0 0 3px #0d3c6f,0 6px 20px rgba(0,0,0,0.18);}.format-iccaformat-card-wrap:active{box-shadow:0 0 0 2px #0d3c6f,0 2px 6px rgba(0,0,0,0.1);}</style>
{{/hover_shadow}}
<div class="format-iccaformat" data-courseid="{{courseid}}">
{{{hovercss}}}
    {{#editingon}}
    <div class="alert alert-info mb-3">{{#str}}editingmode, format_iccaformat{{/str}}</div>
    {{/editingon}}
    {{#canedit}}
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:1rem;padding:8px 12px;background:#f8f9fa;border-radius:8px;border:1px solid #dee2e6;flex-wrap:wrap;">
        <span style="font-size:0.85rem;color:#adb5bd;font-weight:500;margin-right:4px;">ICCA Format</span>
        <a href="{{imageliburl}}" class="btn btn-secondary btn-sm" style="display:inline-flex;align-items:center;gap:5px;">
            <i class="fa fa-picture-o" aria-hidden="true"></i>
            {{#str}}formatlibrary_course, format_iccaformat{{/str}}
        </a>
        <a href="{{labelrulesurl}}" class="btn btn-secondary btn-sm" style="display:inline-flex;align-items:center;gap:5px;">
            <i class="fa fa-tag" aria-hidden="true"></i>
            {{#str}}labelrules_course, format_iccaformat{{/str}}
        </a>
        <button type="button" class="btn btn-secondary btn-sm" style="display:inline-flex;align-items:center;gap:5px;"
            onclick="iccaShowResetDialog()">
            <i class="fa fa-refresh" aria-hidden="true"></i>
            {{#str}}reset_overrides_btn, format_iccaformat{{/str}}
        </button>
    </div>

    <div id="icca-reset-dialog" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99999;align-items:center;justify-content:center;">
      <div style="background:#fff;border-radius:10px;padding:1.5rem;width:90%;max-width:420px;box-shadow:0 8px 32px rgba(0,0,0,0.2);">
        <h4 style="margin:0 0 0.5rem;font-size:1.1rem;">Reset Card Styling Overrides</h4>
        <p style="font-size:0.9rem;color:#6c757d;margin:0 0 1rem;">Choose what to reset for this course. This cannot be undone.</p>
        <label style="display:flex;align-items:center;gap:8px;font-size:1rem;margin-bottom:10px;cursor:pointer;font-weight:500;">
            <input type="checkbox" id="icca-reset-all" onchange="iccaResetSelectAll(this)" style="accent-color:#0d3c6f;width:16px;height:16px;">
            Select all
        </label>
        <div style="border-top:0.5px solid #dee2e6;padding-top:10px;display:flex;flex-direction:column;gap:8px;margin-bottom:1rem;">
        <label style="display:flex;align-items:center;gap:8px;font-size:1rem;cursor:pointer;">
            <input type="checkbox" id="icca-reset-icons" onchange="iccaResetUpdateAll()" style="accent-color:#0d3c6f;width:16px;height:16px;">
            Icons <span style="font-size:0.85rem;color:#adb5bd;">(show/hide + custom icon overrides)</span>
        </label>
        <label style="display:flex;align-items:center;gap:8px;font-size:1rem;cursor:pointer;">
            <input type="checkbox" id="icca-reset-labels" onchange="iccaResetUpdateAll()" style="accent-color:#0d3c6f;width:16px;height:16px;">
            Labels <span style="font-size:0.85rem;color:#adb5bd;">(show/hide + custom label text overrides)</span>
        </label>
        <label style="display:flex;align-items:center;gap:8px;font-size:1rem;cursor:pointer;">
            <input type="checkbox" id="icca-reset-images" onchange="iccaResetUpdateAll()" style="accent-color:#0d3c6f;width:16px;height:16px;">
            Images <span style="font-size:0.85rem;color:#adb5bd;">(image selections and display options)</span>
        </label>
        <label style="display:flex;align-items:center;gap:8px;font-size:1rem;cursor:pointer;">
            <input type="checkbox" id="icca-reset-flipped" onchange="iccaResetUpdateAll()" style="accent-color:#0d3c6f;width:16px;height:16px;">
            Flipped Icons <span style="font-size:0.85rem;color:#adb5bd;">(icon and label flip overrides)</span>
        </label>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;">
            <button type="button" onclick="iccaCloseResetDialog()" style="padding:8px 16px;background:transparent;border:1px solid #dee2e6;border-radius:6px;font-size:1rem;cursor:pointer;">Cancel</button>
            <button type="button" id="icca-reset-confirm-btn" onclick="iccaDoReset('{{resetoverridesurl}}')" style="padding:8px 16px;background:#dc3545;color:#fff;border:none;border-radius:6px;font-size:1rem;cursor:pointer;font-weight:500;">Reset selected</button>
        </div>
      </div>
    </div>

    <script>
    function iccaShowResetDialog() {
        ['icca-reset-all','icca-reset-icons','icca-reset-labels','icca-reset-images'].forEach(function(id){ document.getElementById(id).checked = false; });
        var btn = document.getElementById('icca-reset-confirm-btn');
        btn.disabled = false; btn.textContent = 'Reset selected';
        document.getElementById('icca-reset-dialog').style.display = 'flex';
    }
    function iccaCloseResetDialog() { document.getElementById('icca-reset-dialog').style.display = 'none'; }
    function iccaResetSelectAll(cb) {
        ['icca-reset-icons','icca-reset-labels','icca-reset-images','icca-reset-flipped'].forEach(function(id){ document.getElementById(id).checked = cb.checked; });
    }
    function iccaResetUpdateAll() {
        var all = ['icca-reset-icons','icca-reset-labels','icca-reset-images','icca-reset-flipped'].every(function(id){ return document.getElementById(id).checked; });
        document.getElementById('icca-reset-all').checked = all;
    }
    function iccaDoReset(baseurl) {
        var icons  = document.getElementById('icca-reset-icons').checked  ? 1 : 0;
        var labels = document.getElementById('icca-reset-labels').checked ? 1 : 0;
        var images = document.getElementById('icca-reset-images').checked ? 1 : 0;
        if (!icons && !labels && !images) { alert('Please select at least one option to reset.'); return; }
        var btn = document.getElementById('icca-reset-confirm-btn');
        btn.disabled = true; btn.textContent = 'Resetting...';
        var flipped = document.getElementById('icca-reset-flipped').checked ? 1 : 0;
        var body = 'sesskey=' + M.cfg.sesskey + '&reseticons=' + icons + '&resetlabels=' + labels + '&resetimages=' + images + '&resetflipped=' + flipped;
        fetch(baseurl, {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:body})
            .then(function(r){return r.json();})
            .then(function(d){ if (d.success) { iccaCloseResetDialog(); location.reload(); } });
    }
    document.getElementById('icca-reset-dialog').addEventListener('click', function(e){ if(e.target===this) iccaCloseResetDialog(); });
    </script>
    {{/canedit}}
    {{#hassections}}
    <div class="format-iccaformat-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax({{gridmin}},{{gridmax}}));gap:1.25rem;padding:1rem 0;align-items:start;">
        {{#sectioncards}}{{> format_iccaformat/local/content/section_card }}{{/sectioncards}}
    </div>
    {{/hassections}}
    {{^hassections}}
    <div class="text-muted p-4">{{#str}}nosections, format_iccaformat{{/str}}</div>
    {{/hassections}}
</div>
