{{!
    Template: format_iccaformat/local/content/activity_card
}}
<div class="format-iccaformat-card-wrap" style="display:flex;flex-direction:column;border-radius:{{borderradius}}px;border:1px solid rgba(0,0,0,0.1);background:#fff;min-height:248px;">

<a href="{{url}}"
   class="format-iccaformat-card format-iccaformat-activity-card{{#hidden}} dimmed{{/hidden}}"
   style="display:flex;flex-direction:column;flex:1;width:100%;min-height:0;text-decoration:none;color:inherit;background:transparent;">

    <div class="format-iccaformat-card-image" style="width:100%;flex:1;background:{{imagebgcolour}};overflow:hidden;position:relative;border-radius:{{#showfooter}}{{borderradius}}px {{borderradius}}px 0 0{{/showfooter}}{{^showfooter}}{{borderradius}}px{{/showfooter}};">
        {{#hasimage}}
        <img src="{{imageurl}}" alt="" role="presentation"
             style="position:absolute;inset:0;width:100%;height:100%;object-fit:{{imageobjectfit}};object-position:{{imageobjectposition}};filter:{{imagefilter}};display:block;">
        {{/hasimage}}
        {{#haslabel}}
        <span style="position:absolute;top:0.5rem;left:0.5rem;background:rgba(0,0,0,0.55);color:#fff;font-size:15px;font-weight:500;padding:3px 10px;border-radius:4px;display:inline-flex;align-items:center;gap:5px;">
            {{^flipped}}{{#hasicon}}<i class="fa {{icon}}" style="font-size:15px;" aria-hidden="true"></i>{{/hasicon}}{{/flipped}}
            {{label}}
            {{#flipped}}{{#hasicon}}<i class="fa {{icon}}" style="font-size:15px;" aria-hidden="true"></i>{{/hasicon}}{{/flipped}}
        </span>
        {{/haslabel}}
        {{^haslabel}}
        {{#hasicon}}
        <span style="position:absolute;top:0.5rem;left:0.5rem;background:rgba(0,0,0,0.55);color:#fff;font-size:15px;font-weight:500;padding:3px 10px;border-radius:4px;display:inline-flex;align-items:center;gap:5px;min-height:27px;">
            <i class="fa {{icon}}" style="font-size:15px;" aria-hidden="true"></i>
        </span>
        {{/hasicon}}
        {{/haslabel}}
        {{#hasoverlay}}
        <div style="position:absolute;inset:0;background:{{imageoverlay}};pointer-events:none;"></div>
        {{/hasoverlay}}
        {{#hidden}}
        <div style="position:absolute;top:0.5rem;right:0.5rem;z-index:2;">
            <span style="background:rgba(0,0,0,0.6);color:#fff;font-size:15px;padding:3px 10px;border-radius:4px;display:inline-flex;align-items:center;gap:5px;white-space:nowrap;">
                <i class="fa fa-eye-slash" aria-hidden="true"></i>
                {{#str}}card_hidden, format_iccaformat{{/str}}
            </span>
        </div>
        {{/hidden}}
        {{#restricted}}
        <div style="position:absolute;top:0.5rem;left:0.5rem;right:0.5rem;z-index:2;" onclick="event.preventDefault();event.stopPropagation();">
            <button type="button"
                onclick="iccaToggleRestriction(this)"
                style="background:rgba(0,0,0,0.6);border:none;color:#fff;font-size:15px;padding:3px 10px;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:5px;white-space:nowrap;font-family:inherit;float:right;">
                <i class="fa fa-lock" aria-hidden="true"></i>
                {{#str}}card_restricted, format_iccaformat{{/str}}
                <i class="fa fa-chevron-down" aria-hidden="true" style="font-size:11px;"></i>
            </button>
            <div class="icca-restriction-panel" style="display:none;clear:both;margin-top:6px;background:rgba(0,0,0,0.82);border-radius:6px;padding:10px 12px;max-height:120px;overflow-y:auto;width:100%;box-sizing:border-box;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,0.3) transparent;">
                <div style="font-size:15px;color:#fff;line-height:1.5;" class="icca-restriction-text">
                    {{{restrictioninfo}}}
                    {{#restrictedbysection}}<p style="margin:0;font-size:13px;color:rgba(255,255,255,0.8);font-style:italic;">{{#str}}card_restrictedbysection, format_iccaformat{{/str}}</p>{{/restrictedbysection}}
                </div>
            </div>
        </div>
        {{/restricted}}
        <div class="{{scrimclass}}" style="position:absolute;bottom:0;left:0;right:0;padding:1.5rem 0.85rem 0.65rem;background:linear-gradient(to top,rgba(0,0,0,0.65) 0%,transparent 100%);transition:padding 0.3s ease;">
            <p style="margin:0;font-size:1.25rem;font-weight:600;line-height:1.3;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,0.4);">{{name}}</p>
            {{#hasdescription}}
            <div class="icca-hover-desc" style="max-height:0;overflow:hidden;opacity:0;transition:max-height 0.35s ease,opacity 0.3s ease;font-size:{{descfontsize}}rem;color:rgba(255,255,255,0.88);line-height:1.45;margin-top:0;">
                {{{description}}}
            </div>
            {{/hasdescription}}
        </div>
    </div>

</a>

{{! Footer — only rendered when showfooter is true }}
{{#showfooter}}
<div style="padding:0 1rem;background:#fff;border-radius:0 0 {{borderradius}}px {{borderradius}}px;min-height:52px;display:flex;flex-direction:column;justify-content:center;">
    <div style="display:flex;align-items:center;gap:5px;font-size:{{footerfontsize}};">
        {{#completiondone}}
        <i class="fa fa-check-circle" style="color:{{completioncolour}};" aria-hidden="true"></i>
        <span style="color:{{completioncolour}};">{{completionlabel}}</span>
        {{/completiondone}}
        {{#completionfailed}}
        <i class="fa fa-times-circle" style="color:#dc3545;" aria-hidden="true"></i>
        <span style="color:#dc3545;">{{completionlabel}}</span>
        {{#completioncriteria}}<span style="color:#adb5bd;font-size:1rem;margin-left:auto;">{{completioncriteria}}</span>{{/completioncriteria}}
        {{/completionfailed}}
        {{#completionincomplete}}
        <i class="fa fa-circle-o" style="color:#6c757d;" aria-hidden="true"></i>
        <span style="color:#6c757d;">{{completionlabel}}</span>
        {{#completioncriteria}}<span style="color:#adb5bd;font-size:1rem;margin-left:auto;">{{completioncriteria}}</span>{{/completioncriteria}}
        {{/completionincomplete}}
        {{^hascompletion}}
        <span style="color:#adb5bd;">{{notrackingstr}}</span>
        {{/hascompletion}}
    </div>
</div>
{{/showfooter}}

</div>
